# NetGuard Environment Configuration Example
# Copy to .env for local customization if desired.

# Server Network Binding
# 127.0.0.1 is enforced by default to prevent unauthorized network exposure of packet capture
NETGUARD_HOST=127.0.0.1
NETGUARD_PORT=8000

# Ingestion Mode: DEMO, LIVE, or PCAP
NETGUARD_MODE=DEMO

# Network Capture Interface (optional; defaults to Scapy route-selected adapter if omitted)
# NETGUARD_INTERFACE=Ethernet

# Trusted Local ML Model Artifact Path
NETGUARD_MODEL_PATH=artifacts/demo/model.joblib

# Local SQLite Incident Repository Database
NETGUARD_DB_PATH=artifacts/netguard_incidents.db

# Ingestion Queue Limits
NETGUARD_QUEUE_MAXSIZE=10000

# Anomaly Baseline Warm-up Windows
NETGUARD_ANOMALY_WARMUP=10
