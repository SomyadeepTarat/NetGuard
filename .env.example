# NetGuard Environment Configuration Example
# Set these environment variables in your shell before starting the server.
# This file is documentation; it is not automatically loaded.

# Server Network Binding
# 127.0.0.1 is enforced by default to prevent unauthorized network exposure of packet capture
NETGUARD_HOST=127.0.0.1
NETGUARD_PORT=8000

# Ingestion Mode: auto, demo, live, or pcap
NETGUARD_MODE=auto

# Fallback dataset: PCAP/PCAPNG/CAP inside artifacts/ (never disguised as live).
# If omitted, auto discovers artifacts/datasets/* or artifacts/*.
# Without a dataset or usable capture driver it falls back to labeled synthetic fixtures.
# NETGUARD_DATASET_PCAP=artifacts/datasets/network.pcap

# Optional frozen benign reference built using the ablation runner and a PCAP manifest.
# Synthetic fixture references are deliberately not loaded into live sessions.
# NETGUARD_FUSION_REFERENCE=artifacts/research/fusion_reference.json

# Network Capture Interface (optional; defaults to Scapy route-selected adapter if omitted)
# NETGUARD_INTERFACE=Ethernet

# Trusted Local ML Model Artifact Path
NETGUARD_MODEL_PATH=artifacts/demo/model.joblib

# Local SQLite Incident Repository Database
NETGUARD_DB_PATH=artifacts/netguard_incidents.db

# Ingestion Queue Limits
NETGUARD_QUEUE_MAXSIZE=10000

# Anomaly Baseline Warm-up Windows
NETGUARD_ANOMALY_WARMUP=10
